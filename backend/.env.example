# Copy to .env (or export) - every value has a sensible default.
DATABASE_URL=sqlite:///./disaster_response.db
UPLOAD_DIR=../uploads
MAX_IMAGE_BYTES=5242880
MAX_IMPORT_RECORDS=1000
RESOURCE_SEARCH_RADIUS_METRES=100000
RESOURCE_MAX_SEARCH_RADIUS_METRES=100000
REPORT_RELATIONSHIP_TIME_WINDOW_HOURS=24
REPORT_RELATIONSHIP_RADIUS_KM=25
ENABLE_SEMANTIC_REPORT_MATCHING=false
FAISS_INDEX_DIR=../data/faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Groq-backed response planning. Without a key, deterministic planning is used.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20
GROQ_MAX_RESOURCES=50
GROQ_MAX_TOKENS=1200
GROQ_TEMPERATURE=0.2

# Advisory image analysis uses the bundled local classifier; no provider key is required.

# Required to enable signed login sessions. Use a unique random secret per deployment.
AUTH_SECRET_KEY=
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_EXPIRE_MINUTES=480

# Optional local demo accounts. Leave unset in shared environments.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_COORDINATOR_EMAIL=
DEMO_COORDINATOR_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
