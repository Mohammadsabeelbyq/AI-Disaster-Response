# Copy to .env (or export) - every value has a sensible default.
DATABASE_URL=sqlite:///./disaster_response.db
UPLOAD_DIR=../uploads
MAX_IMAGE_BYTES=5242880
MAX_IMPORT_RECORDS=1000
FAISS_INDEX_DIR=../data/faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional advisory image understanding. Reports work without a provider key.
ENABLE_IMAGE_ANALYSIS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required to enable signed login sessions. Use a unique random secret per deployment.
AUTH_SECRET_KEY=
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_EXPIRE_MINUTES=480

# Optional local demo accounts. Leave unset in shared environments.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_COORDINATOR_EMAIL=
DEMO_COORDINATOR_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
